# One file per systemd instance:
#   /etc/soar-client/instances/1.env
# The unit reads it as root; keep it mode 0600 because it contains a password.
#
# These override the corresponding values in /etc/soar-client/client.json.
SOAR_LISTEN=0.0.0.0:10886
SOAR_USERNAME=soar1
SOAR_PASSWORD=replace-with-a-long-random-password

# Optional: select a per-instance resolver list. If omitted, the wrapper uses
# /etc/soar-client/resolvers.txt. Different resolver lists give the bonding
# core independent DNS paths; they do not make one TCP stream faster.
# SOAR_ARGS="-mode manual -resolvers /etc/soar-client/instances/1.resolvers"

# Optional: give this instance a different panel account/config file.
# SOAR_CONFIG=/etc/soar-client/accounts/2.json
