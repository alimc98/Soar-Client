# Select how the systemd service gets its resolvers.
#
# Manual mode: use the list you maintain in /etc/soar-client/resolvers.txt.
SOAR_ARGS="-mode manual -resolvers /etc/soar-client/resolvers.txt"

# Optional listener/credential overrides. Leave commented to use client.json.
# These are exported by soar-client-run and take precedence over the config.
# SOAR_LISTEN=0.0.0.0:10886
# SOAR_USERNAME=soar
# SOAR_PASSWORD=replace-with-a-long-random-password

# Auto mode: scan candidates on every service start, verify the survivors with
# a real Soar handshake, then start the proxy with the measured list.
# Uncomment the line below and comment the manual line above to switch.
# SOAR_ARGS="-mode auto -candidates /etc/soar-client/candidates.txt -scan-out /var/lib/soar-client/scan -scan-list /var/lib/soar-client/resolvers-auto.txt -samples 5 -workers 64 -depth full -verify-workers 2"
