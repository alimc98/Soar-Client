# Shell scripts, systemd units, and env files must keep LF endings: they run on Linux.
*.sh text eol=lf
*.service text eol=lf
*.env text eol=lf
*.example text eol=lf
soar-client-run text eol=lf
soar-client-instance text eol=lf

# Go source and text data.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Generated reports / spreadsheets are binary.
*.xlsx binary
*.png binary
*.jpg binary

# Keep Git metadata files LF as well.
.gitattributes text eol=lf
.gitignore text eol=lf
